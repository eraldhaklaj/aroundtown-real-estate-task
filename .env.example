# Copy to .env and fill in. .env is git-ignored.
ANTHROPIC_API_KEY=
# Models (optional; these are the defaults)
QA_MODEL=claude-haiku-4-5-20251001
QA_FALLBACK_MODEL=claude-sonnet-5
GENERATOR_MODEL=claude-sonnet-5
# AI features pause for the rest of the UTC day once estimated spend reaches this (USD)
AI_DAILY_SPEND_CAP_USD=5
# Any random string of 32+ chars, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`
JWT_SECRET=some-random-string-example-change-me
PORT=3001
